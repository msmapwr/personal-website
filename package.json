{
  "name": "personal-website",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check-content": "node scripts/check-content.mjs",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "generate-feed": "node scripts/generate-feed.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "report:performance": "node scripts/report-performance.mjs",
    "build": "npm run typecheck && npm run check-content && npm run test && npm run generate-feed && vite build && npm run check-bundle",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.0.0",
    "@fluentui/react-icons": "^2.0.0",
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.15",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "fast-xml-parser": "^5.11.1",
    "jsdom": "^24.1.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
